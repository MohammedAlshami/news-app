# Cloudflare D1 / Wrangler / Drizzle Kit
# Get these from:
# - Workers & Pages dashboard for the account ID
# - D1 database details for the database ID
# - Cloudflare API tokens with D1 edit permissions
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Cloudflare R2 (optional — without these, cover + inline images use `public/uploads/...`).
# Dashboard → R2 → Create bucket → Manage R2 API Tokens (Object Read & Write on that bucket).
# Expose the bucket: R2 → bucket → Settings → Public access (e.g. r2.dev subdomain) — use that base as R2_PUBLIC_URL (no trailing slash).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
