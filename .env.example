# Cloudflare D1 / Wrangler / Drizzle Kit
# Get these from:
# - Workers & Pages dashboard for the account ID
# - D1 database details for the database ID
# - Cloudflare API tokens with D1 edit permissions
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Cloudflare R2 (optional — without these, cover + inline images use `public/uploads/...`).
# Dashboard → R2 → Create bucket → Manage R2 API Tokens (Object Read & Write on that bucket).
# Expose the bucket: R2 → bucket → Settings → Public access (e.g. r2.dev subdomain) — use that base as R2_PUBLIC_URL (no trailing slash).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OpenCode
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash

# Auth — set as Worker secrets in production (`wrangler secret put <NAME>`); locally in .env.local AND .dev.vars (preview).
# SESSION_SECRET: >= 32 random chars, signs the session cookie.   CRON_SECRET: Bearer secret for /api/cron/* (scheduler worker sends it).
# AUTH_USERS: JSON array, hashes from `pnpm auth:hash-password '<password>'`.
SESSION_SECRET=
CRON_SECRET=
AUTH_USERS=

# Canonical public origin (no trailing slash). Defaults to the workers.dev URL; set to the custom domain once attached.
SITE_URL=
