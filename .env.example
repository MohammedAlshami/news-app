# Neon: Project → Branches → your branch → Connect → "Connection string"
# (Use the "pooled" URL for serverless. Include ?sslmode=require if the URL does not already.)
#
#   postgresql://USER:PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=

# Cloudflare R2 (optional — without these, cover + inline images use `public/uploads/...`).
# Dashboard → R2 → Create bucket → Manage R2 API Tokens (Object Read & Write on that bucket).
# Expose the bucket: R2 → bucket → Settings → Public access (e.g. r2.dev subdomain) — use that base as R2_PUBLIC_URL (no trailing slash).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
